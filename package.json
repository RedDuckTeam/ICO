{
  "name": "ico-template",
  "version": "1.0.0",
  "description": "Educational ICO template: whitelisting, oracle-priced (Chainlink + TWAP) payments, and vesting",
  "license": "MIT",
  "keywords": [
    "solidity",
    "hardhat",
    "ico",
    "token-sale",
    "vesting",
    "whitelist",
    "chainlink",
    "twap",
    "uniswap-v3",
    "template",
    "educational"
  ],
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "clean": "hardhat clean",
    "node": "hardhat node",
    "deploy:localhost": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network mainnet",
    "verify:sepolia": "hardhat verify --network sepolia",
    "verify:mainnet": "hardhat verify --network mainnet",
    "smoke-test:localhost": "hardhat run scripts/smoke-test.ts --network localhost"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^3.0.0",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "chai": "^4.4.1",
    "dotenv": "^16.5.0",
    "hardhat": "^2.24.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "viem": "^2.31.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.3.0"
  }
}
