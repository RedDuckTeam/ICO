# RPC endpoint for Ethereum mainnet (e.g. from Alchemy or Infura).
# Leave unset to disable the `mainnet` network entirely.
MAINNET_RPC_URL=

# RPC endpoint for the Sepolia testnet (e.g. from Alchemy or Infura).
# Leave unset to disable the `sepolia` network entirely.
SEPOLIA_RPC_URL=

# Private key of the deployer account, used for every configured network.
# Never commit a real key. For mainnet, use a dedicated deployer wallet —
# not one that also holds unrelated funds.
PRIVATE_KEY=

# Optional: for contract verification via `hardhat verify` (works for both
# mainnet and Sepolia — Etherscan issues one API key for all networks).
ETHERSCAN_API_KEY=
